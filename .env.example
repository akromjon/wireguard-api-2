# WireGuard API Configuration
# Copy this file to .env and customize the values

# API Settings
API_PORT=8080
API_TOKEN=replace-this-with-your-secure-random-token

# AmneziaWG Paths (the side-by-side installer writes interface-specific paths)
WG_CONFIG_FILE=/etc/amnezia/amneziawg/awg0.conf
WG_PARAMS_FILE=/etc/amnezia/amneziawg/params
WIREGUARD_CLIENTS=/home/wireguard/users

# Debug Settings
DEBUG_MODE=false

# Generate new client configs with UDP port 443 as the endpoint.
# This does not change the WireGuard listener (SERVER_PORT).
USE_UDP_443_ENDPOINT=false

# Version 2 generates AmneziaWG 2.0 client configurations.
# The legacy value is retained only for controlled compatibility testing.
AWG_PROFILE=awg2
